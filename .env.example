LOG_LEVEL=INFO
CORS_ORIGIN=*

# 仅在构建镜像时使用：原 sandbox-demo 根目录
ORIGINAL_MODEL_ROOT=../sandbox-demo
# Docker Hub 不可达但本机已有兼容 CUDA 基础镜像时可覆盖
# BASE_IMAGE=sandbox-gesture-gpu:base

# 语音识别
ASR_HOST=0.0.0.0
ASR_PORT=9004
ASR_ENABLED=true
ASR_MODEL=/models/asr/whisper-large-v3
ASR_DOWNLOAD_ROOT=/models/asr
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=zh
ASR_BEAM_SIZE=5
ASR_INITIAL_PROMPT=这是智能眼镜语音助手。它能让机器狗去超市，执行找、抓、夹、走等操作，超市里常见商品包括：橙汁、葡萄汁、可乐、盲盒。
ASR_HOTWORDS=橙汁 葡萄汁 可乐 盲盒 拉布布
ASR_MAX_UPLOAD_MB=50
ASR_CONCURRENCY=1

# 意图分类：默认沿用原本地 Qwen2.5-0.5B，并在失败时回退规则
INTENT_HOST=0.0.0.0
INTENT_PORT=8011
INTENT_BACKEND=hybrid
INTENT_MODEL=/models/intent/Qwen2.5-0.5B-Instruct
INTENT_DEVICE=auto
INTENT_MAX_NEW_TOKENS=128

# YOLO / Orange SDK 视频服务
VIDEO_HOST=0.0.0.0
VIDEO_PORT=28500
VIDEO_PUBLIC_IP=172.30.0.10
VIDEO_SOURCE_WAIT_SECONDS=12
VIDEO_SESSION_TTL_SECONDS=7200
YOLO_ENABLED=true
YOLO_MODEL=/models/yolo/yolov8s-worldv2.pt
YOLO_DEVICE=0
YOLO_CONFIDENCE=0.3
YOLO_IOU=0.4
YOLO_IMAGE_SIZE=640
# YOLO_CLASSES=person,dog,cup

# 视频输出
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=15

# WebRTC；Orange N6 直连默认只使用 host ICE candidate
WEBRTC_ICE_SERVERS=
WEBRTC_ICE_USERNAME=
WEBRTC_ICE_CREDENTIAL=
WEBRTC_ICE_GATHER_TIMEOUT_S=8

# Orange N6 网络。compose_n6 由 Orange Core 网路栈创建。
N6_NETWORK_NAME=compose_n6
CONFIGURE_N6_ROUTES=true
UPF_N6_IP=172.30.0.2
UE_INTERNET_CIDR=10.60.0.0/16
UE_ACN_CIDR=10.61.0.0/16
