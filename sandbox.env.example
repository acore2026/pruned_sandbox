LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
CORS_ORIGIN=*
# CMF管理接口Bearer Token；为空仅适用于本地开发。
FREE6GC_COMPUTING_SANDBOX_MANAGEMENT_TOKEN=

# 仅在构建镜像时使用：三类本地模型源目录
ASR_MODEL_SOURCE=./models/whisper-models/whisper-large-v3
INTENT_MODEL_SOURCE=./models/semantic-models/Qwen/Qwen2.5-0.5B-Instruct
YOLO_MODEL_SOURCE=./models/yolo-models
# Docker Hub 不可达但本机已有兼容 CUDA 基础镜像时可覆盖
# BASE_IMAGE=sandbox-gesture-gpu:base

# 语音识别
ASR_HOST=0.0.0.0
ASR_PORT=9004
ASR_ENABLED=true
ASR_MODEL=/models/asr/whisper-large-v3
ASR_DOWNLOAD_ROOT=/models/asr
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=zh
ASR_BEAM_SIZE=5
ASR_INITIAL_PROMPT=这是智能眼镜与机器狗协同执行园区巡逻的语音助手。用户可以请求机器狗巡逻园区内指定区域，并在巡逻过程中下达向前、退后、向左和向右等方向指令。
ASR_HOTWORDS=机器狗 巡逻 园区 区域 A区域 B区域 向前 退后 向左 向右 左转 右转
ASR_MAX_UPLOAD_MB=50
ASR_CONCURRENCY=1
# Sandbox运行期音频动作接口调用的内部ASR地址。
SANDBOX_ASR_URL=http://127.0.0.1:9004/api/v1/transcribe

# 意图分类：默认沿用原本地 Qwen2.5-0.5B，并在失败时回退规则
INTENT_HOST=127.0.0.1
INTENT_PORT=8011
INTENT_BACKEND=hybrid
INTENT_MODEL=/models/intent/Qwen2.5-0.5B-Instruct
INTENT_DEVICE=auto
INTENT_MAX_NEW_TOKENS=128
# 服务端预设候选意图；眼镜请求无需携带该字段。
INTENT_CANDIDATES=patrol,movement,find_object,grab,other
# Video统一接口调用Intent内部服务；不可用时回退本地规则。
SANDBOX_INTENT_URL=http://127.0.0.1:8011/api/v1/intent
# 9004直连ASR在转写后只附加意图结果，不触发控制动作。
ASR_INTENT_URL=http://127.0.0.1:8011/api/v1/intent
# 机器狗业务控制端点由实际部署约定；支持ue_ipv4_address等绑定字段占位符。
# SANDBOX_PRODUCER_CONTROL_URL=http://{ue_ipv4_address}:8080/v1/control-actions
SANDBOX_PRODUCER_CONTROL_TIMEOUT_S=15

# Sandbox双入口：管理面仅供CMF调用，用户面承载N6业务
SANDBOX_MANAGEMENT_HOST=0.0.0.0
SANDBOX_MANAGEMENT_PORT=28501
SANDBOX_USER_PORT=28502

# YOLO / Orange SDK 视频服务
VIDEO_HOST=0.0.0.0
# 联调时填写当前GPU机器的Tailscale IPv4（tailscale ip -4）。
VIDEO_PUBLIC_IP=127.0.0.1
VIDEO_SOURCE_WAIT_SECONDS=12
YOLO_ENABLED=true
YOLO_MODEL=/models/yolo/yolov8s-worldv2.pt
YOLO_DEVICE=0
YOLO_CONFIDENCE=0.3
YOLO_IOU=0.4
YOLO_IMAGE_SIZE=640
# YOLO_CLASSES=person,dog,cup

# 视频输出
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=30
# H.264 FU-A 的 RTP payload 上限；为 1280-byte Android TUN MTU 预留协议开销
VIDEO_H264_RTP_PAYLOAD_BYTES=1150

# WebRTC；Orange N6 直连默认只使用 host ICE candidate
WEBRTC_ICE_SERVERS=
WEBRTC_ICE_USERNAME=
WEBRTC_ICE_CREDENTIAL=
WEBRTC_ICE_GATHER_TIMEOUT_S=8
